{
  "name": "torflow",
  "version": "1.1.0",
  "private": true,
  "description": "Cloud-ready WebTorrent to HTTP Range streaming engine.",
  "overrides": {
    "@fastify/ajv-compiler": {
      "ajv": {
        "fast-uri": "3.1.9"
      }
    }
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/patch-webtorrent.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.0",
    "bencode": "^4.0.0",
    "dotenv": "^16.4.7",
    "fast-uri": "4.2.3",
    "fastify": "5.12.7",
    "ip-address": "10.7.4",
    "parse-torrent": "9.1.5",
    "pino": "^9.6.0",
    "webtorrent": "2.6.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
