HOST=0.0.0.0
PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=https://your-app.example
TORFLOW_API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
OPENSUBTITLES_API_KEY=

# Optional: adds Jackett/Prowlarr results to the built-in public adapters.
# The resolver works without these two variables.
INDEXER_URL=
INDEXER_API_KEY=
RESOLVER_TIMEOUT_MS=45000

CACHE_DIR=/tmp/torflow-cache
CACHE_MAX_BYTES=2147483648
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_TORRENTS=4
LOG_LEVEL=info
RESOLUTION_CACHE_ENABLED=true
RESOLUTION_CACHE_TTL_SECONDS=3600
RESOLUTION_CACHE_MAX_ENTRIES=500
RESOLVER_DEBUG=false
HLS_ENABLED=false
SUBTITLE_FALLBACK_URL=
SUBTITLE_FALLBACK_API_KEY=
